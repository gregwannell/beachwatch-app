# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Type Generation (Optional - only needed for generating TypeScript types)
# Only required when running: npm run gen-types
SUPABASE_PROJECT_ID=your_project_id

# CARTO Basemap
# Free key from https://carto.com/basemaps/apikey/ — removes the "API KEY REQUIRED"
# tile watermark on the map. Must be NEXT_PUBLIC_ (used in a client component).
# Manage keys/restrictions at https://dashboard.basemaps.carto.com
#
# IMPORTANT: if a key is domain-restricted in the CARTO dashboard, it returns 403
# on any other origin and the map renders BLANK tiles — worse than the watermark.
# Unsetting this var falls back to keyless (watermarked but working) tiles, so
# prefer an unset var over a wrong key.
#
#   Production  -> key restricted to the production domain
#   Preview/dev -> an unrestricted key, or leave unset to accept the watermark
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=your_carto_basemap_key
